# Correct MIME types for JS/CSS modules — some hosts serve these as text/plain
# otherwise, which browsers refuse to execute as ES modules.
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories (JS, CSS, images, sitemap...) as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route: fall back to index.html.
  RewriteRule ^ index.html [L]
</IfModule>
